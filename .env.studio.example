# Dubbing Studio settings on the VPS (copy to .env.studio)

# Google Gemini key — https://aistudio.google.com/apikey (new keys start with AQ.)
GEMINI_API_KEY=

# Sign-in is through the Telegram bot only (no password form). Optional: 1 = also allow
# email + password, which then REQUIRES a long STUDIO_ADMIN_PASSWORD (login: cm5722254@gmail.com).
STUDIO_PASSWORD_LOGIN=0
STUDIO_ADMIN_PASSWORD=

# 1 = people can register accounts themselves (default closed)
STUDIO_ALLOW_REGISTER=0

# Telegram auto-login: the bot token comes from DUBBER_BOT_TOKEN in .env.
# ADMINS: your Telegram numeric user id(s), comma separated (ask @userinfobot). Anyone listed
# is admin when they open the app from the bot; remove an id and they lose admin on next login.
STUDIO_TELEGRAM_ADMIN_IDS=
# 0 = only people who already have an account (default 1: created on first use)
STUDIO_TELEGRAM_SIGNUP=1

# Optional
ELEVENLABS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
