# Copy to ".env" next to docker-compose.yml ONLY on the VPS if the bot's own .env is
# not there; otherwise add these lines to the existing .env.
# Hostnames (sslip.io resolves <name>.184-174-38-113.sslip.io to 184.174.38.113)
STUDIO_HOST=dub.184-174-38-113.sslip.io
SONG_HOST=song.184-174-38-113.sslip.io
BOT_HOST=bot.184-174-38-113.sslip.io
# The bot's token — lets the studio log people in automatically from the bot
TELEGRAM_LOGIN_BOT_TOKEN=
# Git ref of the studio to build (use main after merging)
STUDIO_GIT_REF=claude/admiring-curie-90hbte
# Shared secret between the studio and the VoxCPM2 container (deploy_vps.sh fills it in)
VOXCPM_API_KEY=
# The Khmer Dubber bot (create in @BotFather -> /newbot). It is ALSO the token the studio
# uses to verify Telegram logins, so set TELEGRAM_LOGIN_BOT_TOKEN to the same value.
DUBBER_BOT_TOKEN=
# The bot's @username without @ (shown on the sign-in screen when opened outside Telegram)
DUBBER_BOT_USERNAME=TeleScriptsAgentbot
# Optional: https://t.me/<your-username> shown as a "Help" button
DUBBER_SUPPORT_URL=
# Git ref of the Khmer Sonic AI app to build (saveitkh/khmer-song- repo)
SONG_GIT_REF=claude/khmer-song-ui-production-9z3b8b
# Khmer Sonic AI engines — leave as mock until keys are set + Khmer eval passes.
# SONG_VOICE_PROVIDER=mock   # mock | voxcpm2 | gemini-tts
# SONG_LYRICS_PROVIDER=mock  # mock | claude
# SONG_MUSIC_PROVIDER=mock   # mock | gemini-lyria
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# VOXCPM_WORKER_URL=
# VOXCPM_WORKER_SECRET=
# Open the Khmer Sonic AI app in a plain browser (mock data) — keep off in prod
# SONG_ALLOW_BROWSER_DEMO=on
