# Copy to .env and fill in the same values the Railway service had
# (Railway -> backend -> Variables). Never commit the filled-in .env.

# Public address. setup.sh fills these in; with no domain of your own,
# <ip-with-dashes>.sslip.io resolves to the VPS so Caddy can still get a cert.
DOMAIN=
PUBLIC_URL=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_PHONE=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

BACKEND_API_KEY=
KH_INVOICE_BRIDGE_SECRET=
KH_INVOICE_WEB_URL=
WEB_APP_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_URL=

BAKONG_API_BASE=
BAKONG_API_TOKEN=
ABA_MERCHANT_NAME=
ABA_INGEST_SECRET=

YTDLP_COOKIES_CONTENT=

# SaveIt AI (OpenRouter). Every use costs AI Credit: AI_FREE_DAILY free per
# person per day, then bought Credit (packs "ai_1/5/10" in bot_packages).
# AI_COSTS sets the price per use; AI_MODELS ("id|Label,id|Label") overrides
# the auto-picked model menu.
OPENROUTER_API_KEY=
AI_FREE_DAILY=5
AI_COSTS=cheap=1,premium=3,image=5,song=25
AI_MODELS=

# 🆓 Gemini Free: Google's free API tier, no AI Credit charged. Key from
# aistudio.google.com -> Get API key. Google's free quota is shared by the
# whole bot, so each person gets AI_GEMINI_FREE_DAILY messages a day.
GEMINI_API_KEY=
AI_GEMINI_FREE_DAILY=20

# 🆓 Llama Free: Groq's own free tier (console.groq.com -> API Keys), no
# card, no cost -- a second free pool, independent of Google's, so one
# provider's free tier going away doesn't take 🆓 down entirely.
GROQ_API_KEY=
AI_GROQ_FREE_DAILY=15

# 🎵 songs (ElevenLabs Music). Unset = no song button.
ELEVENLABS_API_KEY=
AI_SONG_SECONDS=120
